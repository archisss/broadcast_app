# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# CONFIGURACIÓN SUPABASE (OPCIONAL: Si se desea usar directamente Supabase)
# El sistema incluye un backend Express Real-Time integrado que funciona de inmediato.
# Para producción con Supabase, completa las siguientes credenciales:
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica-de-supabase"
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica-de-supabase"

# Nombre del hospital personalizado
VITE_HOSPITAL_NAME="Hospital Materno Infantil San Lucas"
VITE_TV_CHANNEL="waiting-room"

# =========================================================================
# CONFIGURACIÓN POSTGRESQL (COOLIFY / POSTGRES 18 DOCKER)
# =========================================================================
# Cadena de conexión completa para PostgreSQL 18:
# Formato: postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/postgres
# Ejemplo interno en Coolify: postgresql://postgres:miPassword@postgresql-database-b1eu0urkbwv2dp856lok3kph:5432/postgres
# Ejemplo externo con IP de VPS: postgresql://postgres:miPassword@tu-vps-ip:3000/postgres
DATABASE_URL=

# Variables individuales opcionales:
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres

